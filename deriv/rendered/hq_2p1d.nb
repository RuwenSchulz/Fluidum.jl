          RowBox[{"(", 
           SuperscriptBox["u", "x"], ")"}], "2"]}], "+", 
        SuperscriptBox["\[Nu]", "y"]}], ")"}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["u", "\[Tau]"], ")"}], "2"]]}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"aa3ea6b8-a2a5-4b4b-\
b641-6073be460c77"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    SubsuperscriptBox["A", "y", "L"], 
    SubscriptBox[")", "32"]}], "=", 
   RowBox[{"-", 
    FractionBox[
     RowBox[{
      SubscriptBox["\[Tau]", "n"], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        SuperscriptBox["u", "y"], ")"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         SuperscriptBox["\[Nu]", "x"], " ", 
         SuperscriptBox[
          RowBox[{"(", 
           SuperscriptBox["u", "y"], ")"}], "2"]}], "+", 
        SuperscriptBox["\[Nu]", "x"], "-", 
        RowBox[{
         SuperscriptBox["\[Nu]", "y"], " ", 
         SuperscriptBox["u", "x"], " ", 
         SuperscriptBox["u", "y"]}]}], ")"}]}], 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["u", "\[Tau]"], ")"}], "2"]]}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"f14ff166-86a9-449b-\
a5c7-5d3cdeead0e1"],

Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"(", 
    SubsuperscriptBox["A", "y", "L"], 
    SubscriptBox[")", "33"]}], "=", 
   FractionBox[
    RowBox[{
     SubscriptBox["\[Tau]", "n"], " ", 
     SuperscriptBox[
      RowBox[{"(", 
       SuperscriptBox["u", "y"], ")"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        SuperscriptBox["\[Nu]", "x"], " ", 
        SuperscriptBox["u", "x"], " ", 
        SuperscriptBox["u", "y"]}], "-", 
       RowBox[{
        SuperscriptBox["\[Nu]", "y"], " ", 
