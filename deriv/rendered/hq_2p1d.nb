    RowBox[{"\[Tau]", " ", 
     SuperscriptBox["u", "\[Tau]"]}]]}], TraditionalForm]], "DisplayFormula",E\
xpressionUUID->"ad12fe6a-82c2-4dce-995d-b5458b8a9f10"],

