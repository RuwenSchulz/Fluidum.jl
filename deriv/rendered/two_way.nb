      SuperscriptBox["\[Pi]", 
       RowBox[{"y", "y"}]], ",", 
      RowBox[{
       SuperscriptBox["\[Pi]", "\[Eta]"], 
       SubscriptBox["", "\[Eta]"]}], ",", 
      SuperscriptBox["\[Pi]", 
       RowBox[{"x", "y"}]], ",", "\[Alpha]", ",", 
      SuperscriptBox["\[Nu]", "x"], ",", 
      SuperscriptBox["\[Nu]", "y"], ",", 
      SubsuperscriptBox["\[Pi]", "Q", 
       RowBox[{"x", "x"}]], ",", 
      SubsuperscriptBox["\[Pi]", "Q", 
       RowBox[{"x", "y"}]], ",", 
      SubsuperscriptBox["\[Pi]", "Q", 
       RowBox[{"y", "y"}]], ",", 
      SubscriptBox["\[CapitalPi]", "Q"]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"554b2f5e-801a-479d-b614-722d44103aff"],
 "."
}], "Text",ExpressionUUID->"ce7383d5-17fc-472e-ad50-14a88b29e9dd"],

