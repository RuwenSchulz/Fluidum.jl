HQ_const_BG.jl READ FROM THE FILE\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G2car-uu\"\>", "\<\"u.u == -1\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G2car-un\"\>", "\<\"u.nu == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G3car\"\>", "\<\"Cartesian system is quasi-linear\"\>", "\<\"PASS\
\"\>"},
    {"\<\"H-G5\"\>", "\<\"slab limit (u^y -> 0, d_y -> 0) decouples nu^y from \
(alpha, nu^x)\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G6a\"\>", "\<\"the (alpha, nu^x, nu^y) columns of the 10-field \
rows == the background-mode matrices\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G6b\"\>", "\<\"src_live + (medium columns).(background \
derivatives) == src_background: same system, re-sorted\"\>", "\<\"PASS\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
