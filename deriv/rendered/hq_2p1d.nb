 FormBox[
  RowBox[{
   SubsuperscriptBox["S", "2", "L"], "=", 
   SuperscriptBox["\[Nu]", "x"]}], TraditionalForm]], "DisplayFormula",Express\
ionUUID->"56689b93-e9d0-493d-946a-ab0a3cbc96af"],

Cell[BoxData[
 FormBox[
