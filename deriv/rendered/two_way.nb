Cell["Checks", "Section",ExpressionUUID->"c7e6cbe8-2d3f-41f5-b113-a38d329da23e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"id\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"what it tests\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"G0-0p1d\"\>", "\<\"Nabla g == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"G1-0p1d\"\>", "\<\"trap detector: Nabla.(X(tau,..),0,0,0) == X' + \
X/tau (Christoffel AND sqrt(-g) routes)\"\>", "\<\"PASS\"\>"},
    {"\<\"G2-0p1d\"\>", "\<\"u.u=-1; u.pi=0, tr pi=0 (medium); u.nu=0; \
u.piQ=0, tr piQ=0; both symmetric\"\>", "\<\"PASS\"\>"},
    {"\<\"G-aQ-0p1d\"\>", "\<\"aQ' has identically vanishing coefficient in \
the second-moment rows (symbolic); dropped\"\>", "\<\"PASS\"\>"},
    {"\<\"G3-0p1d\"\>", "\<\"every row (medium, charm-in-T, first moment, \
second moment) is quasi-linear\"\>", "\<\"PASS\"\>"},
    {"\<\"S3-free-0p1d\"\>", "\<\"S3 rows carry no second-moment field and no \
c (c enters only through dM)\"\>", "\<\"PASS\"\>"},
    {"\<\"S34-nomedpi-0p1d\"\>", "\<\"charm rows never see the medium pi or \
Pi (so S3/S4 need only T, u as background)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-extract-0p1d\"\>", "\<\"A_t dphi + A_x dphi (+A_y dphi) + src == \
the raw rows (symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-ctrl-0p1d\"\>", "\<\"control: the exact random-point zero test \
REJECTS a 1e-9-perturbed identity and a nonzero row\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-total-0p1d\"\>", "\<\"S5 fluid rows == Nabla_mu (T_m + T_Q)^{mu \
nu}, sqrt(-g) route (symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-number-0p1d\"\>", "\<\"charm row == Nabla.N, sqrt(-g) route \
(symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c0-0p1d\"\>", "\<\"c = 0: dM columns of the fluid + first-moment \
rows vanish identically, and their sources carry no dM\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c1-0p1d\"\>", "\<\"c = 1: the dM columns are LIVE (the gate \
above is not vacuous)  [0+1D: dM enters only the energy row's source]\"\>", "\
\<\"PASS\"\>"},
    {"\<\"Gc-c1src-0p1d\"\>", "\<\"0+1D, c = 1: dM enters the energy row's \
source (Bjorken work of the charm stress)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-off-0p1d\"\>", "\<\"charm off (n, nu, dM -> 0): S5's medium \
block and medium sources == S2 exactly; the charm rows' medium columns and \
sources vanish, so charm = 0 is an invariant subspace on which S5 IS S2\"\>", \
"\<\"PASS\"\>"},
    {"\<\"G0-1p1d\"\>", "\<\"Nabla g == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"G1-1p1d\"\>", "\<\"trap detector: Nabla.(X(tau,..),0,0,0) == X' + \
X/tau (Christoffel AND sqrt(-g) routes)\"\>", "\<\"PASS\"\>"},
    {"\<\"G2-1p1d\"\>", "\<\"u.u=-1; u.pi=0, tr pi=0 (medium); u.nu=0; \
u.piQ=0, tr piQ=0; both symmetric\"\>", "\<\"PASS\"\>"},
    {"\<\"G2-triad\"\>", "\<\"the (l, phihat, etahat) triad is orthonormal \
and transverse\"\>", "\<\"PASS\"\>"},
    {"\<\"G-aQ-1p1d\"\>", "\<\"aQ' has identically vanishing coefficient in \
the second-moment rows (symbolic); dropped\"\>", "\<\"PASS\"\>"},
    {"\<\"G3-1p1d\"\>", "\<\"every row (medium, charm-in-T, first moment, \
second moment) is quasi-linear\"\>", "\<\"PASS\"\>"},
    {"\<\"S3-free-1p1d\"\>", "\<\"S3 rows carry no second-moment field and no \
c (c enters only through dM)\"\>", "\<\"PASS\"\>"},
    {"\<\"S34-nomedpi-1p1d\"\>", "\<\"charm rows never see the medium pi or \
Pi (so S3/S4 need only T, u as background)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-extract-1p1d\"\>", "\<\"A_t dphi + A_x dphi (+A_y dphi) + src == \
the raw rows (symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-ctrl-1p1d\"\>", "\<\"control: the exact random-point zero test \
REJECTS a 1e-9-perturbed identity and a nonzero row\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-total-1p1d\"\>", "\<\"S5 fluid rows == Nabla_mu (T_m + T_Q)^{mu \
nu}, sqrt(-g) route (symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-number-1p1d\"\>", "\<\"charm row == Nabla.N, sqrt(-g) route \
(symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c0-1p1d\"\>", "\<\"c = 0: dM columns of the fluid + first-moment \
rows vanish identically, and their sources carry no dM\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c1-1p1d\"\>", "\<\"c = 1: the dM columns are LIVE (the gate \
above is not vacuous)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-off-1p1d\"\>", "\<\"charm off (n, nu, dM -> 0): S5's medium \
block and medium sources == S2 exactly; the charm rows' medium columns and \
sources vanish, so charm = 0 is an invariant subspace on which S5 IS S2\"\>", \
"\<\"PASS\"\>"},
    {"\<\"G0-2p1d\"\>", "\<\"Nabla g == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"G1-2p1d\"\>", "\<\"trap detector: Nabla.(X(tau,..),0,0,0) == X' + \
X/tau (Christoffel AND sqrt(-g) routes)\"\>", "\<\"PASS\"\>"},
    {"\<\"G2-2p1d\"\>", "\<\"u.u=-1; u.pi=0, tr pi=0 (medium); u.nu=0; \
u.piQ=0, tr piQ=0; both symmetric\"\>", "\<\"PASS\"\>"},
    {"\<\"G-aQ-2p1d\"\>", "\<\"aQ' has identically vanishing coefficient in \
the second-moment rows (symbolic); dropped\"\>", "\<\"PASS\"\>"},
    {"\<\"G3-2p1d\"\>", "\<\"every row (medium, charm-in-T, first moment, \
second moment) is quasi-linear\"\>", "\<\"PASS\"\>"},
    {"\<\"S3-free-2p1d\"\>", "\<\"S3 rows carry no second-moment field and no \
c (c enters only through dM)\"\>", "\<\"PASS\"\>"},
    {"\<\"S34-nomedpi-2p1d\"\>", "\<\"charm rows never see the medium pi or \
Pi (so S3/S4 need only T, u as background)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-extract-2p1d\"\>", "\<\"A_t dphi + A_x dphi (+A_y dphi) + src == \
the raw rows (exact at 4 random rational points)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-ctrl-2p1d\"\>", "\<\"control: the exact random-point zero test \
REJECTS a 1e-9-perturbed identity and a nonzero row\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-total-2p1d\"\>", "\<\"S5 fluid rows == Nabla_mu (T_m + T_Q)^{mu \
nu}, sqrt(-g) route (symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-number-2p1d\"\>", "\<\"charm row == Nabla.N, sqrt(-g) route \
(symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c0-2p1d\"\>", "\<\"c = 0: dM columns of the fluid + first-moment \
rows vanish identically, and their sources carry no dM\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-c1-2p1d\"\>", "\<\"c = 1: the dM columns are LIVE (the gate \
above is not vacuous)\"\>", "\<\"PASS\"\>"},
    {"\<\"Gc-off-2p1d\"\>", "\<\"charm off (n, nu, dM -> 0): S5's medium \
block and medium sources == S2 exactly; the charm rows' medium columns and \
sources vanish, so charm = 0 is an invariant subspace on which S5 IS S2\"\>", \
"\<\"PASS\"\>"},
    {"\<\"R0-jl2wl\"\>", "\<\"Julia -> WL conversion of the shipped/generated \
matrices (0)\"\>", "\<\"PASS\"\>"},
    {"\<\"R-S2-1p1d-shipped\"\>", "\<\"S2 1+1D generic EOS, dpp = dPP = 0 == \
SHIPPED one_d_viscous_matrix (1d_viscous_cilindrical.jl), entry by entry (55 \
entries, symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"R-S2-1p1d-generator\"\>", "\<\"S2 1+1D, dpp = dPP = 0 == \
one_d_viscous_matrix_derived (derive_2p1d_viscous.wls output), entry by entry \
(55 entries, symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"R-S2-2p1d-generator\"\>", "\<\"S2 2+1D, dpp = dPP = 0 == \
two_d_viscous_matrix_derived (derive_2p1d_viscous.wls output), entry by entry \
(154 entries, symbolic)\"\>", "\<\"PASS\"\>"},
    {"\<\"R-S3-2p1d-generator\"\>", "\<\"S3 2+1D == hq2d_matrices_consistent \
(derive_hq_consistent_2p1d.wls output), entry by entry (30 entries, symbolic)\
\"\>", "\<\"PASS\"\>"},
    {"\<\"R-S2-1p1d-MIS\"\>", "\<\"S2 1+1D with dpp = 4/3 tauS, dPP = 0 == \
