      SuperscriptBox["u", "\[Tau]"], ")"}], "2"]]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"874975aa-d270-4096-\
8a9a-bbeacace042e"],

Cell[BoxData[
 FormBox[
