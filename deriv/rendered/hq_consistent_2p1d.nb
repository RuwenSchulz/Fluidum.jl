              SuperscriptBox["u", "y"], ")"}], " ", "\[Tau]", " ", 
             SuperscriptBox["u", "y"]}], "+", 
            RowBox[{
             SuperscriptBox[
              RowBox[{"(", 
               SuperscriptBox["u", "y"], ")"}], "2"], " ", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 SubscriptBox["\[PartialD]", "x"], 
                 SuperscriptBox["u", "x"], ")"}], " ", "\[Tau]", " ", 
                SuperscriptBox["u", "\[Tau]"]}], "+", 
               RowBox[{
                RowBox[{"(", 
                 SubscriptBox["\[PartialD]", "y"], 
                 SuperscriptBox["u", "y"], ")"}], " ", "\[Tau]", " ", 
                SuperscriptBox["u", "\[Tau]"]}], "+", "2"}], ")"}]}], "+", 
            RowBox[{
             RowBox[{"(", 
              SubscriptBox["\[PartialD]", "x"], 
              SuperscriptBox["u", "x"], ")"}], " ", "\[Tau]", " ", 
             SuperscriptBox["u", "\[Tau]"]}], "+", 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              SubscriptBox["\[PartialD]", "y"], 
              SuperscriptBox["u", "y"], ")"}], " ", "\[Tau]", " ", 
             SuperscriptBox["u", "\[Tau]"]}], "+", 
            SuperscriptBox[
             RowBox[{"(", 
              SuperscriptBox["u", "y"], ")"}], "4"], "+", "1"}], ")"}]}]}], 
        ")"}]}]}], ")"}]}]}], TraditionalForm]], "DisplayFormula",ExpressionUU\
ID->"ac9b7d4f-2514-42c7-b8b6-5bdf598ddc03"],

Cell["Checks", "Section",ExpressionUUID->"af902eda-ea55-4840-888b-6b16f36de4b6"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"id\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"what it tests\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"HC-G0cyl\"\>", "\<\"cylindrical Milne: Nabla g == 0\"\>", "\<\"PASS\
\"\>"},
    {"\<\"HC-G0car\"\>", "\<\"Cartesian   Milne: Nabla g == 0\"\>", "\<\"PASS\
\"\>"},
    {"\<\"HC-G1cyl\"\>", "\<\"cylindrical: Nabla.V = X' + X/tau\"\>", \
"\<\"PASS\"\>"},
    {"\<\"HC-G1car\"\>", "\<\"Cartesian:   Nabla.V = X' + X/tau\"\>", \
"\<\"PASS\"\>"},
    {"\<\"HC-G2cyl-uu\"\>", "\<\"u.u == -1\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-G2cyl-un\"\>", "\<\"u.nu == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-G3cyl\"\>", "\<\"cylindrical consistent system is quasi-linear\"\
\>", "\<\"PASS\"\>"},
    {"\<\"HC-C1\"\>", "\<\"cylindrical static nu=0 source == (Ds/T) d_r P0  \
(== the 1-D hqc_matrices source)\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-G2car-uu\"\>", "\<\"u.u == -1\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-G2car-un\"\>", "\<\"u.nu == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-G3car\"\>", "\<\"Cartesian consistent system is \
quasi-linear\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-C2\"\>", "\<\"Cartesian at-rest NS source == kappa d_x alpha + \
(Ds/T)(n + T dn_dT) d_x T\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-C3\"\>", "\<\"consistent - shipped == the four named terms, \
exactly (x-row)\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-C4\"\>", "\<\"slab limit (u^y -> 0, d_y -> 0) decouples \
nu^y\"\>", "\<\"PASS\"\>"},
    {"\<\"HC-C5\"\>", "\<\"consistent row minus the named terms == the \
shipped row\"\>", "\<\"PASS\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {Automatic, 45, Automatic}}],
  "Grid"]], "Output",ExpressionUUID->"d4d84a51-6e49-4902-b050-e6b432750bb1"],

