    {"\<\"V-G6cyl\"\>", "\<\"cylindrical: (IS + dpp pi theta in eq. 2) == IS \
+ dpp * (the exported dpp part), equation by equation\"\>", "\<\"PASS\"\>"},
    {"\<\"V-G4\"\>", "\<\"1-D: derived == shipped one_d_viscous_matrix, A_t, \
A_r, src entry by entry, read from the .jl, SYMBOLIC dpp  [CONTROL]\"\>", "\<\
