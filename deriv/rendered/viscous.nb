Cell[BoxData[
 FormBox[
  RowBox[{
   RowBox[{"2", " ", 
    SubscriptBox["\[Pi]", "\[Lambda]"], 
    SuperscriptBox["", 
     RowBox[{"\[LeftAngleBracket]", "\[Mu]"}]], 
    SuperscriptBox["\[Omega]", 
     RowBox[{"\[Nu]", "\[RightAngleBracket]", "\[Lambda]"}]]}], ",", " ", 
   RowBox[{
    SuperscriptBox["\[Omega]", 
     RowBox[{"\[Mu]", "\[Nu]"}]], "=", 
    RowBox[{
     FractionBox["1", "2"], 
     SuperscriptBox["\[CapitalDelta]", 
      RowBox[{"\[Mu]", "\[Alpha]"}]], 
     RowBox[{
      SuperscriptBox["\[CapitalDelta]", 
       RowBox[{"\[Nu]", "\[Beta]"}]], "(", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Del]", "\[Alpha]"], 
        SubscriptBox["u", "\[Beta]"]}], "-", 
       RowBox[{
        SubscriptBox["\[Del]", "\[Beta]"], 
        SubscriptBox["u", "\[Alpha]"]}]}], ")"}]}]}]}], 
  TraditionalForm]], "DisplayFormula",ExpressionUUID->"52c56320-cfda-499d-\
aa71-be07645a9e17"],

