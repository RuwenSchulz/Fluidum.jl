   SubsuperscriptBox["S", "3", "L"], "=", 
   SuperscriptBox["\[Nu]", "y"]}], TraditionalForm]], "DisplayFormula",Express\
ionUUID->"e2c32fa0-a448-47f2-bc92-cdbb91a39204"],

Cell["Checks", "Section",ExpressionUUID->"421f6765-fc37-4d53-af6b-5f4c22601d35"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"id\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"what it tests\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"H-G0cyl\"\>", "\<\"cylindrical Milne: Nabla g == 0\"\>", \
"\<\"PASS\"\>"},
    {"\<\"H-G0car\"\>", "\<\"Cartesian   Milne: Nabla g == 0\"\>", \
"\<\"PASS\"\>"},
    {"\<\"H-G1cyl\"\>", "\<\"cylindrical: Nabla.V = X' + X/tau for \
V=(X(tau),0,0,0)\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G1car\"\>", "\<\"Cartesian:   Nabla.V = X' + X/tau\"\>", \
"\<\"PASS\"\>"},
    {"\<\"H-G2cyl-uu\"\>", "\<\"u.u == -1\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G2cyl-un\"\>", "\<\"u.nu == 0\"\>", "\<\"PASS\"\>"},
    {"\<\"H-G3cyl\"\>", "\<\"cylindrical system is quasi-linear\"\>", \
"\<\"PASS\"\>"},
